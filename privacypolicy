<style>
  :root {
    --bg: #0A0C10;
    --surface: #131820;
    --surface-2: #1B2230;
    --gold: #FACC15;
    --green: #4ADE80;
    --text: #F5F5F0;
    --text-muted: #8993A4;
    --text-dim: #4F5764;
    --border: rgba(255, 255, 255, 0.07);
    --border-strong: rgba(255, 255, 255, 0.14);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Archivo', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 500;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.7;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        135deg,
        transparent 0px,
        transparent 2px,
        rgba(255, 255, 255, 0.012) 2px,
        rgba(255, 255, 255, 0.012) 3px
      );
    pointer-events: none;
    z-index: 0;
  }

  nav, main, footer { position: relative; z-index: 1; }

  /* NAV */
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 48px;
    max-width: 1500px;
    margin: 0 auto;
    border-bottom: 1px solid var(--border);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .nav-logo img { height: 38px; width: auto; }

  .nav-logo span {
    font-family: 'Archivo Black', sans-serif;
    font-size: 14px;
    letter-spacing: 2.5px;
    color: var(--text);
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    gap: 40px;
    list-style: none;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-family: 'Archivo', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--gold); }
  .nav-links a.active { color: var(--text); }

  /* HERO */
  .page-hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: 80px 48px 50px;
    border-bottom: 2px solid var(--border-strong);
  }

  .page-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--gold);
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .page-eyebrow::before {
    content: '';
    width: 36px;
    height: 1px;
    background: var(--gold);
  }

  .page-title {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(56px, 9vw, 132px);
    line-height: 0.88;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin-bottom: 32px;
  }

  .page-meta {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 10px 18px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .page-meta b {
    color: var(--text);
    font-weight: 700;
  }

  .page-meta-divider {
    width: 1px;
    height: 14px;
    background: var(--border-strong);
  }

  /* CONTENT */
  .content {
    max-width: 820px;
    margin: 0 auto;
    padding: 60px 48px 100px;
  }

  .content h2 {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(28px, 3vw, 36px);
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin: 64px 0 24px;
    color: var(--text);
    line-height: 1.05;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-strong);
    display: flex;
    align-items: baseline;
    gap: 18px;
  }

  .content h2:first-child { margin-top: 0; }

  .content h2 .num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 500;
    color: var(--gold);
    letter-spacing: 1px;
    flex-shrink: 0;
  }

  .content h3 {
    font-family: 'Archivo Black', sans-serif;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 1px;
    margin: 32px 0 12px;
    color: var(--text);
    text-transform: uppercase;
  }

  .content p {
    color: var(--text);
    font-size: 16px;
    line-height: 1.75;
    margin-bottom: 18px;
    font-weight: 500;
  }

  .content p.muted {
    color: var(--text-muted);
  }

  .content strong, .content b {
    color: var(--text);
    font-weight: 700;
  }

  .content a {
    color: var(--green);
    text-decoration: none;
    border-bottom: 1px solid rgba(74, 222, 128, 0.4);
    transition: border-color 0.2s, color 0.2s;
    font-weight: 600;
  }

  .content a:hover {
    color: var(--green);
    border-bottom-color: var(--green);
  }

  .content ul {
    list-style: none;
    margin: 18px 0;
    padding: 0;
  }

  .content ul li {
    position: relative;
    padding-left: 24px;
    margin-bottom: 12px;
    color: var(--text);
    font-size: 16px;
    line-height: 1.65;
    font-weight: 500;
  }

  .content ul li::before {
    content: '◆';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--gold);
    font-size: 11px;
  }

  .content table {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    overflow: hidden;
  }

  .content table th {
    text-align: left;
    padding: 14px 18px;
    font-family: 'Archivo Black', sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    background: #000;
    border-bottom: 1px solid var(--border-strong);
  }

  .content table td {
    padding: 16px 18px;
    font-size: 14px;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    font-weight: 500;
  }

  .content table tr:last-child td { border-bottom: none; }

  .callout {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-left: 4px solid var(--gold);
    border-radius: 4px;
    padding: 22px 28px;
    margin: 28px 0;
  }

  .callout p:last-child { margin-bottom: 0; }

  .divider {
    height: 1px;
    background: var(--border);
    margin: 56px 0;
  }

  .contact-card {
    background: #000;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 36px 40px;
    margin-top: 28px;
  }

  .contact-card .contact-header {
    font-family: 'Archivo Black', sans-serif;
    font-size: 12px;
    letter-spacing: 2.5px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--border-strong);
  }

  .contact-card p { margin-bottom: 10px; }
  .contact-card p:last-child { margin-bottom: 0; }

  /* FOOTER */
  .footer {
    border-top: 1px solid var(--border);
    background: #000;
  }

  .footer-inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: 40px 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .footer-left img { height: 32px; opacity: 0.7; }

  .footer-copy {
    color: var(--text-dim);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .footer-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-family: 'Archivo', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .footer-links a:hover { color: var(--gold); }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .nav { padding: 18px 24px; }
    .nav-links { gap: 22px; }
    .nav-logo span { display: none; }

    .page-hero { padding: 50px 24px 30px; }
    .content { padding: 40px 24px 80px; }

    .content h2 {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    .content table {
      display: block;
      overflow-x: auto;
    }

    .page-meta { flex-direction: column; align-items: flex-start; gap: 8px; padding: 14px 18px; }
    .page-meta-divider { display: none; }

    .footer-inner { padding: 30px 24px; flex-direction: column; text-align: center; }
  }
</style>
